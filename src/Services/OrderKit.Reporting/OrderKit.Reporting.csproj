<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OrderKit.Reporting</AssemblyName>
    <RootNamespace>OrderKit</RootNamespace>
  </PropertyGroup>

  <!-- Versions are declared once, in Directory.Packages.props. Central Package Management
       is switched off only when analysis tooling replaces Directory.Build.props (it adds
       versioned PackageReference items of its own); the second group then supplies versions. -->
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="System.Data.SqlClient" Version="$(SystemDataSqlClientVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OrderKit.Domain\OrderKit.Domain.csproj" />
  </ItemGroup>

</Project>
